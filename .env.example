# Odoo backend (server-only — never PUBLIC_ prefixed)
ODOO_URL=https://your-odoo-instance.example.com
ODOO_DB=your_db_name
# Odoo administrator login + API key. Used ONLY for signup provisioning and
# admin-key writes in the proxy — never exposed to the browser.
ODOO_USERNAME=admin@example.com
ODOO_API_KEY=your_admin_api_key

# Cloudflare TURN (voice relay). Dashboard -> Realtime -> TURN -> create key.
# Optional: without these, voice is STUN-only (fails across CGNAT/mobile NATs).
CF_TURN_KEY_ID=your_turn_key_id
CF_TURN_API_TOKEN=your_turn_api_token

# Latency instrumentation sink (server-only). The client beacon always writes a
# JSON log line; this also persists it to Odoo's built-in ir.logging so the
# numbers are readable without log tooling (Settings → Technical → Logging, dev
# mode on, filter name = 'gameroom.metrics'). Costs one Odoo create per client
# per 5 minutes — noise against the shared ~1 req/s, but not zero.
# Set to `off` for log-only. OPTIONAL: unset => Odoo sink ON.
METRICS_SINK=

# Gates POST /api/cron/sweep, which DELETES abandoned rooms. The Cron Trigger in
# wrangler.toml dispatches to it through the Worker; the secret is what stops the
# same endpoint being reachable from the internet. REQUIRED in production — the
# route fails closed (503) when unset, so room GC simply never runs without it.
# Generate: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# Web push (browser notifications). Generate once: node scripts/gen-vapid.mjs
# (NOT `npx web-push generate-vapid-keys` — that package was removed when push
# moved to WebCrypto for Workers compatibility.)
# If Odoo already holds a pair in ir.config_parameter, REUSE it rather than
# generating: existing subscriptions are bound to it and are silently broken by
# a new one.
# The public key is exposed to the browser (PUBLIC_ prefix); the private key is
# server-only. Both are also written to Odoo's ir.config_parameter on first
# subscribe so Odoo signs with the same pair. OPTIONAL: unset => the 🔔 bell hides.
PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
